# Copie para .env e preencha. NÃO commite o .env (coberto pelo .gitignore).

# ═══════════════ Identidade da aplicação ═══════════════
TITLE=RCaldas
DESCRIPTION=Serviços Web, Blockchain e Segurança
# Dev: http://localhost:8001 · Produção: https://seu-dominio
AUTH_TRUST_HOST=http://localhost:8001

# TITLE, DESCRIPTION e AUTH_TRUST_HOST acima valem para o `web`. O `car` roda
# no mesmo .env e sobrescreve os três em `environment:` no compose — são os
# únicos valores que precisam divergir entre os apps.

# ═══════════════ Sessão ═══════════════
# Um segredo só para toda a stack: o cookie de sessão `userId` é assinado
# (JWT) com ele e compartilhado entre web, wallet e car. Valores diferentes
# quebram o login único.
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# ═══════════════ Banco ═══════════════
MONGO_URI=mongodb://user:password@mongo/rcaldas?authSource=admin

# ═══════════════ Redis (fila de emails do emailer) ═══════════════
# Uma fila só para todos os apps. A identidade de cada um (nome, URL do
# logo, conjunto de templates) viaja no payload da mensagem, não no
# ambiente do worker — por isso um emailer atende web, car e wallet.
REDIS_URL=redis://redis:6379

# ═══════════════ S3 / MinIO (usado pelo car e pelo wallet) ═══════════════
# Dev: o MinIO do próprio compose. Produção: gateway S3 externo.
S3_HOST=http://minio:9000
S3_KEY=root
S3_SECRET=password

# ═══════════════ Wallet / Stellar ═══════════════
# Secret da conta que financia contas novas e recargas de reserva.
MAIN_WALLET=
# Serviço de cotações (ccxt) na rede do compose.
CCXT_URL=http://ccxt:8000
# Para onde o app web aponta o link do Wallet.
# Dev: /wallet (subcaminho) · Produção: https://wallet.seu-dominio
WALLET_URL=/wallet
# Opcionais — descomente para sobrescrever os padrões:
# STELLAR_NETWORK=public                        # public (padrão) | testnet
# STELLAR_HORIZON=https://horizon.stellar.org
# STELLAR_HOME_DOMAIN=rcaldas.com
# STELLAR_INITIAL_BALANCE=2                     # XLM ao criar conta nova
# STELLAR_RESERVE_TOPUP=1.5                     # XLM de recarga p/ trustline
# BTC_API=https://blockstream.info/api          # aponte p/ Esplora próprio se quiser

# ═══════════════ DigitaR (OCR via IA) ═══════════════
# Sem a chave, a extração de texto do DigitaR falha em tempo de execução.
OPENAI_API_KEY=
OCR_MODEL=gpt-4.1

# ═══════════════ SMTP (emailer) ═══════════════
# Sem SMTP_HOST o emailer roda em dry-run: imprime o email no log e não envia.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ═══════════════ Log centralizado (Grafana) ═══════════════
# Senha do admin do Grafana em logs.rcaldas.com. É a única credencial da
# stack de log — Loki e Alloy não são expostos. O compose falha na subida
# se estiver vazia, de propósito: Grafana sem senha definida cai no
# admin/admin padrão, e isso ficaria na internet atrás da Cloudflare.
GF_SECURITY_ADMIN_PASSWORD=

# ═══════════════ Ambiente ═══════════════
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
